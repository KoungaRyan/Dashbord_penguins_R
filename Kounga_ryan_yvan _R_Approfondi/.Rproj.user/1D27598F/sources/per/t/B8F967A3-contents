```{r}
#| context: server

output$irisOutputId <- renderTable(
  {
    iris %>% 
      head(n=5)
  }
)

output$univariateOutputId <- renderTable({
  variable = input$variableInputId
    iris %>%
  group_by(Species) %>%
      summarise(
        min = min(!!rlang::sym(variable)),
        max = max(!!rlang::sym(variable)),
        mean = mean(!!rlang::sym(variable)),
        var = var(!!rlang::sym(variable)),
        sd = sd(!!rlang::sym(variable)),
        median = median(!!rlang::sym(variable))
    )
  }
)

output$boxplotOutputId <- renderPlotly(
  {
    variable = input$variableInputId
    (iris%>%
        ggplot(mapping = aes(x= Species, y = !!rlang::sym(variable)  ,color=Species))+
        geom_boxplot()
)%>%
  ggplotly()
  }
)

output$histplotOutputId <- renderPlotly(
  {
    variable = input$variableInputId
    (iris%>%
        ggplot(mapping = aes( x = !!rlang::sym(variable)  ,color=Species)) +
        geom_histogram()
)%>%
      ggplotly()
  }
)



output$irisOutputId1 <- renderTable(
  {
    iris %>% 
      head(n=5)
  }
)

output$boxplotOutputId1 <- renderPlotly(
  {
    variable1 = input$variableInputId1
    (
      iris %>%
        ggplot(mapping = aes(x = Species , y = !!rlang::sym(variable1) ,color= Species)) +
        geom_boxplot()
)%>%
      ggplotly()
  }
)

output$nuagedepointplotOutputId <- renderPlotly(
  {
    variable1 = input$variableInputId1
    variable2 = input$variableInputId2
    (
      iris %>%
        ggplot(mapping = aes(x = !!rlang::sym(variable1), y = !!rlang::sym(variable2),color= Species)) +
        geom_point()
)%>%
      ggplotly()
  }
)

output$regressionoutputId <- renderText(
  {
    variable1 = input$variableInputId1
    variable2 = input$variableInputId2
    (
      iris %>% 
        summarise(
           modele = lm(!!rlang::sym(variable1) ~ !!rlang::sym(variable2))
        ) %>%
        summary(modele)
    )
    
  }
)



```
